    "submenus": [
      {
        "id": "claudeExplorer.runMenu",
        "label": "Run",
        "icon": "$(play)"
      },
      {
        "id": "claudeExplorer.copyMenu",
        "label": "Copy",
        "icon": "$(copy)"
      },
      {
        "id": "claudeExplorer.editMenu",
        "label": "Edit",
        "icon": "$(edit)"
      },
      {
        "id": "claudeExplorer.diagnoseMenu",
        "label": "Diagnose",
        "icon": "$(pulse)"
      },
      {
        "id": "claudeExplorer.claudeMenu",
        "label": "Ask Claude Code",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeExplorer.openDashboard",
          "when": "view == claudeExplorer.tree",
          "group": "navigation@0"
        },
        {
          "command": "claudeExplorer.filter",
          "when": "view == claudeExplorer.tree && !claudeExplorer.filtered",
          "group": "navigation@1"
        },
        {
          "command": "claudeExplorer.clearFilter",
          "when": "view == claudeExplorer.tree && claudeExplorer.filtered",
          "group": "navigation@1"
        },
        {
          "command": "claudeExplorer.groupByType",
          "when": "view == claudeExplorer.tree && claudeExplorer.grouping == scope",
          "group": "navigation@2"
        },
        {
          "command": "claudeExplorer.groupByScope",
          "when": "view == claudeExplorer.tree && claudeExplorer.grouping == type",
          "group": "navigation@2"
        },
        {
          "command": "claudeExplorer.refresh",
          "when": "view == claudeExplorer.tree",
          "group": "navigation@3"
        },
        {
          "command": "claudeExplorer.cleanup",
          "when": "view == claudeExplorer.tree && config.claudeExplorer.allowEditing",
          "group": "2_tools@1"
        },
        {
          "command": "claudeExplorer.snippet.new",
          "when": "view == claudeExplorer.snippets",
          "group": "navigation@0"
        },
        {
          "command": "claudeExplorer.snippet.import",
          "when": "view == claudeExplorer.snippets",
          "group": "1_io@1"
        },
        {
          "command": "claudeExplorer.snippet.export",
          "when": "view == claudeExplorer.snippets",
          "group": "1_io@2"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeExplorer.hideEmptyItems",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\bemptiesShown\\b/",
          "group": "inline@9"
        },
        {
          "command": "claudeExplorer.showEmptyItems",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\bemptiesHidden\\b/",
          "group": "inline@9"
        },
        {
          "command": "claudeExplorer.showGuide",
          "when": "view == claudeExplorer.tree && viewItem =~ /^typeGroup/",
          "group": "inline@1"
        },
        {
          "command": "claudeExplorer.addWorkspaceFolder",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\bworkspaceGroup\\b/",
          "group": "inline@1"
        },
        {
          "command": "claudeExplorer.removeWorkspaceFolder",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\battachedScope\\b/",
          "group": "inline@1"
        },
        {
          "command": "claudeExplorer.disableItem",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\btogglable enabled\\b/",
          "group": "inline@2"
        },
        {
          "command": "claudeExplorer.enableItem",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\btogglable disabled\\b/",
          "group": "inline@2"
        },
        {
          "command": "claudeExplorer.openFolder",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\bfolders\\b/",
          "group": "inline@2"
        },
        {
          "command": "claudeExplorer.addPermissionRule",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\bpermissions\\b/",
          "group": "inline@1"
        },
        {
          "command": "claudeExplorer.testMcpServer",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\bmcpServer\\b/",
          "group": "inline@1"
        },
        {
          "command": "claudeExplorer.createItem",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\bcreatable\\b/",
          "group": "inline@0"
        },
        {
          "command": "claudeExplorer.initClaudeDir",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\bnoClaudeDir\\b/",
          "group": "inline@0"
        },
        {
          "command": "claudeExplorer.insertInSession",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\brunnable\\b/",
          "group": "inline@0"
        },
        {
          "command": "claudeExplorer.insertMentionInSession",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\bmentionable\\b/",
          "group": "inline@0"
        },
        {
          "command": "claudeExplorer.editSetting",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\bsettingEditable\\b/",
          "group": "inline@2"
        },
        {
          "command": "claudeExplorer.showGuide",
          "when": "view == claudeExplorer.tree && viewItem =~ /^typeGroup/",
          "group": "0_guide@1"
        },
        {
          "command": "claudeExplorer.showGuide",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\bplaceholder\\b/",
          "group": "0_guide@1"
        },
        {
          "command": "claudeExplorer.showEffectiveSettings",
          "when": "view == claudeExplorer.tree && viewItem =~ /kind-(setting|policy)\\b/",
          "group": "0_guide@2"
        },
        {
          "command": "claudeExplorer.showHookTimeline",
          "when": "view == claudeExplorer.tree && viewItem =~ /kind-hook\\b/",
          "group": "0_guide@2"
        },
        {
          "command": "claudeExplorer.showContextBudget",
          "when": "view == claudeExplorer.tree && viewItem =~ /kind-(memory|skill|rule)\\b/",
          "group": "0_guide@2"
        },
        {
          "command": "claudeExplorer.showSecurity",
          "when": "view == claudeExplorer.tree && viewItem =~ /kind-(setting|policy|mcp|hook)\\b/",
          "group": "0_guide@3"
        },
        {
          "command": "claudeExplorer.openItem",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\bopenable\\b/",
          "group": "1_open@1"
        },
        {
          "command": "claudeExplorer.revealInExplorer",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\bopenable\\b/",
          "group": "1_open@2"
        },
        {
          "command": "claudeExplorer.revealInDashboard",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\bdashboardable\\b/",
          "group": "1_open@3"
        },
        {
          "command": "claudeExplorer.openFolder",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\bfolders\\b/",
          "group": "1_open@4"
        },
        {
          "command": "claudeExplorer.createItem",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\bcreatable\\b/",
          "group": "2_create@1"
        },
        {
          "command": "claudeExplorer.initClaudeDir",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\bnoClaudeDir\\b/",
          "group": "2_create@2"
        },
        {
          "submenu": "claudeExplorer.runMenu",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\b(runnable|mentionable)\\b/",
          "group": "3_menus@0"
        },
        {
          "submenu": "claudeExplorer.copyMenu",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\b(openable|invocable|mcpServer)\\b/",
          "group": "3_menus@1"
        },
        {
          "submenu": "claudeExplorer.editMenu",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\b(togglable|skillVisibility|describable|settingEditable|permissions|runnable|editable)\\b/ || view == claudeExplorer.tree && viewItem =~ /\\bkind-setting\\b/ && config.claudeExplorer.allowEditing",
          "group": "3_menus@2"
        },
        {
          "submenu": "claudeExplorer.diagnoseMenu",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\b(diagnosable|overridden|mcpServer|permissions)\\b|(^| )skill( |$)/",
          "group": "3_menus@3"
        },
        {
          "submenu": "claudeExplorer.claudeMenu",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\b(openable|permissions|placeholder|kind-skill|openScope|attachedScope|userScope)\\b|^typeGroup/",
          "group": "3_menus@4"
        },
        {
          "command": "claudeExplorer.exportReport",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\bexportable\\b/",
          "group": "6_export@1"
        },
        {
          "command": "claudeExplorer.removeWorkspaceFolder",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\battachedScope\\b/",
          "group": "8_scope@1"
        },
        {
          "command": "claudeExplorer.deleteItem",
          "when": "view == claudeExplorer.tree && viewItem =~ /\\beditable\\b/",
          "group": "9_delete@1"
        },
        {
          "command": "claudeExplorer.snippet.sendToSession",
          "when": "view == claudeExplorer.snippets && viewItem == snippet",
          "group": "inline@0"
        },
        {
