    "configuration": {
      "title": "Explorer for Claude Code",
      "properties": {
        "claudeExplorer.defaultGrouping": {
          "type": "string",
          "enum": [
            "scope",
            "type"
          ],
          "default": "scope",
          "markdownDescription": "How to group the tree on first open. 'scope' separates User, Plugins and Workspace; 'type' puts all skills together, all hooks together, and so on.",
          "scope": "window",
          "order": 10
        },
        "claudeExplorer.colorful": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Softly tint the scope headings and type group icons. Turn off for a monochrome tree; problems and unused surfaces stay highlighted either way. The tints themselves can be changed in `workbench.colorCustomizations` (`claudeExplorer.scope.*`, `claudeExplorer.groupIcon`).",
          "scope": "window",
          "order": 15
        },
        "claudeExplorer.showPluginProvided": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Include skills, commands, subagents, hooks and MCP servers that come from installed plugins.",
          "scope": "window",
          "order": 30
        },
        "claudeExplorer.extraProjectPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Additional project folders to scan even when they are not open. Merged with the folders you attach with the + button.",
          "scope": "window",
          "order": 40
        },
        "claudeExplorer.autoRefresh": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Watch the Claude configuration directories and refresh the tree automatically when they change.",
          "scope": "window",
          "order": 50
        },
        "claudeExplorer.refreshDebounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "maximum": 10000,
          "markdownDescription": "How long to wait after a file change before rebuilding the tree, so a burst of saves causes a single rebuild.",
          "scope": "window",
          "order": 60
        },
        "claudeExplorer.showUnusedSurfaces": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show greyed rows for surfaces a scope supports but has nothing configured for, projects without configuration, and the \"no policy\" row. This is the default for the eye icon on the System, User and Workspace headings, which hides or shows those empty rows per heading; changing this setting resets all headings to it.",
          "scope": "window",
          "order": 20
        },
        "claudeExplorer.allowEditing": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show Enable/Disable actions for plugins and project MCP servers. They edit `~/.claude/settings.json` or the project's `.claude/settings.local.json`, always after a confirmation. Turn off and the extension never writes a file.",
          "scope": "window",
          "order": 70
        },
        "claudeExplorer.costModel": {
          "type": "string",
          "enum": [
            "auto",
            "opus-5",
            "sonnet-5",
            "haiku-4-5",
            "fable-5-1"
          ],
          "enumDescriptions": [
            "Use the model set in your Claude Code settings; Claude Opus 5 when none is set.",
            "Claude Opus 5",
            "Claude Sonnet 5",
            "Claude Haiku 4.5",
            "Claude Fable 5.1"
          ],
          "default": "auto",
          "markdownDescription": "Which model's API list prices the context-budget cost estimate uses. An estimate for comparing setups: subscriptions are not billed per token.",
          "scope": "window",
          "order": 80
        },
        "claudeExplorer.inputPricePerMTok": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Override the input price in USD per million tokens for the cost estimate, for when list prices change. `0` uses the built-in price list. Cache prices scale with it.",
          "scope": "window",
          "order": 81
        },
        "claudeExplorer.statusBar": {
          "type": "string",
          "enum": [
            "all",
            "budget",
            "off"
          ],
          "enumDescriptions": [
            "Context estimate, problems, MCP servers and a non-default session mode.",
            "Only the context estimate.",
            "No status bar items."
          ],
          "default": "all",
          "markdownDescription": "What Explorer for Claude Code shows in the status bar, for the project of the active editor.",
          "scope": "window",
          "order": 90
        },
        "claudeExplorer.budgetWarnTokens": {
          "type": "number",
          "default": 10000,
          "minimum": 1,
          "markdownDescription": "Startup context estimate above which the status bar item turns yellow; at twice this value it turns red.",
          "scope": "window",
          "order": 91
        },
        "claudeExplorer.readTranscriptsForUsage": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Count how often skills, slash commands and subagents were used by reading Claude Code's local transcripts (`~/.claude/projects/*/*.jsonl`, last 90 days), so the context budget can suggest hiding ones you do not use. Only names and dates are kept, in memory; nothing leaves the machine. Off by default because transcripts contain whole conversations.",
          "scope": "machine",
          "order": 85
        }
      }
    },
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get started with Explorer for Claude Code",
        "description": "See every piece of Claude Code configuration on this machine, what is broken, and what actually applies.",
        "steps": [
          {
            "id": "browse",
            "title": "Browse your configuration",
            "description": "Every skill, hook, MCP server and setting Claude Code reads, grouped by where it comes from.\n[Open the sidebar](command:workbench.view.extension.claudeExplorer)",
            "media": {
              "markdown": "resources/walkthrough/browse.md"
            },
            "completionEvents": [
              "onView:claudeExplorer.tree"
            ]
          },
          {
            "id": "problems",
            "title": "Find problems",
            "description": "Missing hook scripts, unapproved MCP servers, disabled plugins and more.\n[Show problems](command:claudeExplorer.showProblems)",
            "media": {
              "markdown": "resources/walkthrough/problems.md"
            },
            "completionEvents": [
              "onCommand:claudeExplorer.showProblems"
            ]
          },
          {
            "id": "overview",
            "title": "Open the overview",
            "description": "Context budget, effective settings, hook timeline and overrides on one page.\n[Open overview](command:claudeExplorer.openDashboard)",
            "media": {
              "markdown": "resources/walkthrough/overview.md"
            },
            "completionEvents": [
              "onCommand:claudeExplorer.openDashboard"
            ]
          },
          {
            "id": "attach",
            "title": "Attach another project",
            "description": "Browse a repository without opening it.\n[Attach a folder](command:claudeExplorer.addWorkspaceFolder)",
            "media": {
              "markdown": "resources/walkthrough/attach.md"
            },
            "completionEvents": [
              "onCommand:claudeExplorer.addWorkspaceFolder"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "audit": "node dist/audit.js",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package",
    "lint": "npm run typecheck",
    "test": "node esbuild.test.mjs && node --test-reporter=spec --enable-source-maps --test \"out/test/**/*.test.js\"",
    "test:watch": "node esbuild.test.mjs --watch"
  },
