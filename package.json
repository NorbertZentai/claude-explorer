        "icon": "$(play)"
      },
      {
        "command": "claudeExplorer.insertInSession",
        "title": "Insert in Active Session",
        "category": "Explorer for Claude Code",
        "icon": "$(send)"
      },
      {
        "command": "claudeExplorer.runInSession",
        "title": "Run in Active Session",
        "category": "Explorer for Claude Code",
        "icon": "$(play-circle)"
      },
      {
        "command": "claudeExplorer.insertMentionInSession",
