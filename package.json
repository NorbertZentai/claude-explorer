      },
      {
        "command": "claudeExplorer.snippet.import",
        "title": "Import Snippets…",
        "category": "Explorer for Claude Code",
        "icon": "$(cloud-download)"
      },
      {
        "command": "claudeExplorer.setUpWithClaude",
        "title": "Set Up with Claude Code…",
        "category": "Explorer for Claude Code",
        "icon": "$(sparkle)"
      },
      {
        "command": "claudeExplorer.hardenSecurity",
        "title": "Harden Security with Claude Code…",
        "category": "Explorer for Claude Code",
        "icon": "$(shield)"
      },
      {
        "command": "claudeExplorer.draftSkill",
        "title": "Draft a Skill with Claude Code…",
