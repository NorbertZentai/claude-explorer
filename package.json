      {
        "command": "claudeExplorer.hideEmptyItems",
        "title": "Hide Empty Items",
        "category": "Explorer for Claude Code",
        "icon": "$(eye)"
      },
      {
        "command": "claudeExplorer.showEmptyItems",
        "title": "Show Empty Items",
        "category": "Explorer for Claude Code",
