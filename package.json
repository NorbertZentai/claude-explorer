{
  "name": "explorer-for-claude-code",
  "displayName": "Explorer for Claude Code",
  "description": "Browse every Claude Code skill, command, subagent, hook, MCP server, plugin and setting on your machine. Unofficial, read-only, no account or network required.",
  "version": "0.1.0",
  "publisher": "semaxien",
  "license": "MIT",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/NorbertZentai/claude-explorer.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeExplorer",
          "title": "Claude",
          "icon": "resources/claude.svg"
        }
      ]
    },
    "views": {
      "claudeExplorer": [
        {
          "id": "claudeExplorer.tree",
          "name": "Configuration",
          "icon": "resources/claude.svg",
          "contextualTitle": "Explorer for Claude Code",
          "visibility": "visible"
        },
        {
          "id": "claudeExplorer.snippets",
          "name": "Snippets",
          "icon": "resources/claude.svg",
          "contextualTitle": "Explorer for Claude Code",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeExplorer.tree",
        "contents": "No Claude Code configuration found.\n\nUser-level assets are read from your home directory; workspace assets from the open folder's .claude directory.\n\n[Refresh](command:claudeExplorer.refresh)\n\n[Get Started](command:claudeExplorer.openWalkthrough)"
      },
      {
        "view": "claudeExplorer.snippets",
        "contents": "Keep prompts and instructions you reuse, tag them, and insert them into CLAUDE.md, a rule, or a new Claude Code session.\n\n[New Snippet](command:claudeExplorer.snippet.new)\n\n[Import Snippets…](command:claudeExplorer.snippet.import)"
      }
    ],
    "commands": [
      {
        "command": "claudeExplorer.refresh",
        "title": "Refresh",
        "category": "Explorer for Claude Code",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeExplorer.filter",
        "title": "Filter…",
        "category": "Explorer for Claude Code",
        "icon": "$(search)"
      },
      {
        "command": "claudeExplorer.clearFilter",
